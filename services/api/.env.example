APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/puvexa
# Supabase (real values go in services/api/.env, which is gitignored).
# Legacy names SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY still supported.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET_EVIDENCE=puvexa-evidence
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=15
AI_PROVIDER=unconfigured
# OpenAI (when AI_PROVIDER=openai)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Google Gemini (when AI_PROVIDER=gemini). GEMINI_API_KEY supports both the
# classic `AIza...` and the new AI Studio `AQ.`-prefixed key formats.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_VISION_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Version tag written to case_embeddings/fix_embeddings during provider re-index.
GEMINI_EMBEDDING_VERSION=gemini-mrl-v1
AI_EMBEDDING_DIMENSION=1536
AI_TIMEOUT_SECONDS=30
AI_RETRY_COUNT=2
AI_MAX_EVIDENCE_CHARS=30000
AI_COST_TRACKING_ENABLED=false
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
MIN_SUCCESS_RATE_SAMPLE=5
AI_RATE_LIMIT_PER_DAY=50

# --- Web3 / on-chain economy (BNB Smart Chain TESTNET, chain id 97) ---
# Testnet only. Mainnet chain ids (56, 1, ...) are refused at startup, on every
# web3 request, and by scripts/bnb_testnet_probe.py. Keep ALLOW_MAINNET_DEPLOYMENT=false.
#
# Roles (intentionally separate accounts):
#   DEPLOYER           -> forge script --private-key (never stored here)
#   TREASURY           -> receives the 1B FIXAI supply (public address only)
#   REWARD SIGNER      -> WEB3_REWARD_SIGNER_PRIVATE_KEY (EIP-712 claim signing)
#   TRUSTED VERIFIER   -> operator wallet; holds StakeVault OPERATOR_ROLE. Its key
#                         stays in the operator's wallet, so only the public
#                         address is configured here (WEB3_OPERATOR_ADDRESS).
#   REGISTRY ANCHOR    -> WEB3_REGISTRY_ANCHOR_PRIVATE_KEY (privacy-safe proof anchoring)
#
# Set WEB3_CLAIM_ENABLED=true to turn on prepared-claim verification
# (EIP-712 signatures + on-chain receipt confirmation).
WEB3_CLAIM_ENABLED=false
WALLET_SIGNATURE_VERIFIER=eip191

WEB3_CHAIN_ID=97
# Public BNB Testnet RPC, e.g. https://data-seed-prebsc-1-s1.bnbchain.org:8545
WEB3_TESTNET_RPC_URL=
# Populate from `contracts/deployments/bnb-testnet.json` after `forge script` deploy.
WEB3_TOKEN_ADDRESS=
WEB3_DISTRIBUTOR_ADDRESS=
WEB3_STAKE_VAULT_ADDRESS=
WEB3_REGISTRY_ADDRESS=

# Backend-held keys (server side only; never shipped to the browser).
WEB3_REWARD_SIGNER_PRIVATE_KEY=
WEB3_REGISTRY_ANCHOR_PRIVATE_KEY=

# Trusted verifier (StakeVault OPERATOR_ROLE) public address. Release/slash receipts
# are rejected unless they were broadcast by this account.
WEB3_OPERATOR_ADDRESS=
# Admin policy for the controlled slash path. Leave false until a slash is sanctioned.
WEB3_SLASH_ENABLED=false

# Royalty accrual when attributed knowledge is legitimately reused.
KNOWLEDGE_REUSE_RATE_LIMIT_PER_DAY=20

# Production hardening: keep false. Mainnet chain ids are refused at runtime regardless.
ALLOW_MAINNET_DEPLOYMENT=false
