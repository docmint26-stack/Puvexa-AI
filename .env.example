NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase key scheme. (Legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY still supported.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
POSTGRES_DB=puvexa
POSTGRES_USER=puvexa
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# --- Web3 (BNB Smart Chain TESTNET only) -----------------------------------
# Leave all NEXT_PUBLIC_WEB3_* unset to run in testnet-unconfigured mode: the UI then
# shows an honest "on-chain claiming is not configured" state and never fakes a tx.
# Chain id 97 = BNB Smart Chain Testnet (gas token tBNB).
# Mainnet chain ids (56, 1, 137, ...) are rejected at load time.
#
# NEVER put a private key, reward-signer key, trusted-verifier key or Supabase
# secret key behind NEXT_PUBLIC_*.
NEXT_PUBLIC_WEB3_ENV=testnet
NEXT_PUBLIC_WEB3_CHAIN_ID=97
# Public testnet RPC, e.g. https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_WEB3_RPC_URL=
# BNB Testnet explorer, e.g. https://testnet.bscscan.com
NEXT_PUBLIC_WEB3_EXPLORER_URL=
NEXT_PUBLIC_FIXAI_TOKEN_ADDRESS=
NEXT_PUBLIC_REWARD_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_STAKE_VAULT_ADDRESS=
NEXT_PUBLIC_CONTRIBUTION_REGISTRY_ADDRESS=
