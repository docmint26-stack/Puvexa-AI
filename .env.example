NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase key scheme. (Legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY still supported.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
POSTGRES_DB=puvexa
POSTGRES_USER=puvexa
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# --- Web3 (Phase 5) ---------------------------------------------------------
# Leave all NEXT_PUBLIC_WEB3_* unset to run in testnet-unconfigured mode.
# Set NEXT_PUBLIC_WEB3_ENV=local for the local Anvil development network
# (chain id 31337). Mainnet chain ids are rejected at runtime.
NEXT_PUBLIC_WEB3_ENV=
NEXT_PUBLIC_WEB3_CHAIN_ID=
NEXT_PUBLIC_WEB3_RPC_URL=
NEXT_PUBLIC_WEB3_EXPLORER_URL=
NEXT_PUBLIC_FIXAI_TOKEN_ADDRESS=
NEXT_PUBLIC_REWARD_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_STAKE_VAULT_ADDRESS=
NEXT_PUBLIC_CONTRIBUTION_REGISTRY_ADDRESS=
